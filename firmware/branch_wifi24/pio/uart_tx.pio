;
; PIO UART TX program. 8N1, baud set via clock divider (8 PIO cycles per bit).
; Driven by autopull at threshold 8: writing a byte to the TX FIFO produces one
; framed character on the output pin.
;

.program uart_tx
.side_set 1 opt

    pull       side 1 [7]   ; assert stop bit (idle high), pull next byte
    set x, 7   side 0 [7]   ; start bit
bitloop:
    out pins, 1                ; shift one data bit
    jmp x-- bitloop [6]        ; total 8 PIO cycles per bit

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

static inline void uart_tx_program_init(PIO pio, uint sm, uint offset, uint pin, uint baud) {
    pio_sm_set_pins_with_mask(pio, sm, (1u << pin), (1u << pin));
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << pin), (1u << pin));
    pio_gpio_init(pio, pin);

    pio_sm_config c = uart_tx_program_get_default_config(offset);
    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_out_pins(&c, pin, 1);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    float div = (float)clock_get_hz(clk_sys) / (8.0f * (float)baud);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

/* Pin retargeting lives in pio_uart.c (uart_tx_retarget_pin). The earlier
 * implementation here only re-pinned the GPIO and never updated the state
 * machine's PINCTRL OUT/SIDESET base, so all bytes still left on the
 * originally configured pin. Removed to prevent reuse. */
%}
